@model ShoeProductionApp.ViewModels.ReferenceIndexViewModel
@using ShoeProductionApp.Entities
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"]="Справочник";
    var canManage=User.IsInRole("Менеджер")||User.IsInRole("Мастер");
    var models=new SelectList(Model.Models.Select(x=>new {x.Id,Text=$"{x.Name} ({x.Code})"}),"Id","Text");
    var colors=new SelectList(Model.Colors.Select(x=>new {x.Id,Text=$"{x.Name} ({x.Code})"}),"Id","Text");
    var leathers=new SelectList(Model.Leathers.Select(x=>new {x.Id,Text=$"{x.Name} ({x.Code})"}),"Id","Text");
    var linings=new SelectList(Model.Linings.Select(x=>new {x.Id,Text=$"{x.Name} ({x.Code})"}),"Id","Text");
    var soles=new SelectList(Model.Soles.Select(x=>new {x.Id,Text=$"{x.Name} ({x.Code})"}),"Id","Text");
    var genders=new[]{new SelectListItem("Женская (8)","8"),new SelectListItem("Мужская (9)","9"),new SelectListItem("Женская XL (6)","6"),new SelectListItem("Мужская XL (7)","7")};
}
<h1>Справочник</h1>
@if(TempData["SuccessMessage"] is string ok){<div class="alert alert-success">@ok</div>}
@if(TempData["ErrorMessage"] is string error){<div class="alert alert-danger">@error</div>}
<ul class="nav nav-tabs mb-3">
@foreach(var t in new[]{("articles","Артикулы"),("models","Модели"),("colors","Цвета"),("leathers","Кожа"),("linings","Подкладка"),("soles","Подошва")}){<li class="nav-item"><a class="nav-link @(Model.Tab==t.Item1?"active":"")" asp-action="Index" asp-route-tab="@t.Item1">@t.Item2</a></li>}
</ul>
@if(Model.Tab=="articles")
{
    <form method="get" class="row g-2 mb-3 align-items-end"><input type="hidden" name="tab" value="articles"/><div class="col-sm-8 col-lg-6"><label class="form-label" for="searchArticles">Поиск артикулов</label><input id="searchArticles" class="form-control" name="searchArticles" value="@Model.SearchArticles" placeholder="Поиск по одиннадцатизначному артикулу"/></div><div class="col-auto d-flex gap-2"><button class="btn btn-primary">Найти</button><a asp-action="Index" asp-route-tab="articles" class="btn btn-light border">Сброс</a></div></form>
    @if(canManage){<div class="card mb-4"><div class="card-body"><h5>Добавить артикул</h5><form asp-action="CreateArticle" method="post" enctype="multipart/form-data" class="row g-2">@Html.AntiForgeryToken()
        <div class="col-12 col-md-6 col-xl-4"><label class="form-label">Пол и тип</label><select name="gender" class="form-select" asp-items="genders"></select></div>
        <div class="col-12 col-md-6 col-xl-4"><label class="form-label">Модель</label><select name="modelId" class="form-select" asp-items="models" required><option value="">Выберите</option></select></div>
        <div class="col-12 col-md-6 col-xl-4"><label class="form-label">Цвет</label><select name="colorId" class="form-select" asp-items="colors" required><option value="">Выберите</option></select></div>
        <div class="col-12 col-md-6 col-xl-4"><label class="form-label">Кожа</label><select name="leatherId" class="form-select" asp-items="leathers" required><option value="">Выберите</option></select></div>
        <div class="col-12 col-md-6 col-xl-4"><label class="form-label">Подкладка</label><select name="liningId" class="form-select" asp-items="linings" required><option value="">Выберите</option></select></div>
        <div class="col-12 col-md-6 col-xl-4"><label class="form-label">Подошва</label><select name="soleId" class="form-select" asp-items="soles" required><option value="">Выберите</option></select></div>
        <div class="col-md-6"><label class="form-label">Фотография артикула</label><input type="file" name="image" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" /></div><div class="col-12"><button class="btn btn-primary">Добавить артикул</button></div></form></div></div>}
    @if (Model.Articles.Count == 0)
    {
        <div class="text-muted py-4">Артикулов пока нет.</div>
    }
    @foreach (var a in Model.Articles)
    {
        var editId = $"article-edit-{a.Id}";
        var modalId = $"article-image-{a.Id}";
        <div class="card article-admin-card mb-3">
            <div class="card-body">
                <div class="d-flex flex-wrap align-items-start gap-3">
                    <div class="article-admin-photo">
                        @if (!string.IsNullOrWhiteSpace(a.ImageFileName))
                        {
                            <button type="button" class="btn p-0 border-0" data-bs-toggle="modal" data-bs-target="#@modalId" aria-label="Увеличить фотографию артикула">
                                <img src="@Url.Action("Get", "ArticleImages", new { id = a.Id })" class="article-thumbnail" alt="Фото артикула @a.Article" />
                            </button>
                        }
                        else
                        {
                            <span class="text-muted small">Нет фото</span>
                        }
                    </div>
                    <div class="flex-grow-1 min-width-0">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                            <div>
                                <h5 class="mb-2">Артикул @a.Article</h5>
                                <div class="article-components-summary">
                                    <span>@GenderName(a.Gender)</span>
                                    <span>@a.ModelName (@a.ModelCode)</span>
                                    <span>@a.ColorName (@a.ColorCode)</span>
                                    <span>Кожа: @a.LeatherName (@a.LeatherCode)</span>
                                    <span>Подкладка: @a.LiningName (@a.LiningCode)</span>
                                    <span>Подошва: @a.SoleName (@a.SoleCode)</span>
                                </div>
                            </div>
                            @if (canManage)
                            {
                                <div class="d-flex flex-wrap gap-2 article-card-actions">
                                    <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#@editId" aria-expanded="false" aria-controls="@editId">Изменить</button>
                                    <form asp-action="DeleteArticle" method="post" onsubmit="return confirm('Удалить артикул?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@a.Id" />
                                        <button class="btn btn-sm btn-outline-danger" type="submit">Удалить</button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                @if (canManage)
                {
                    <div class="collapse mt-3" id="@editId">
                        <div class="article-edit-panel">
                            <form asp-action="UpdateArticle" method="post" enctype="multipart/form-data">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@a.Id" />
                                <div class="row g-3">
                                    <div class="col-12 col-md-6 col-xl-4"><label class="form-label">Пол и тип</label><select name="gender" class="form-select" asp-items="@(new SelectList(genders, "Value", "Text", ((int)a.Gender).ToString()))"></select></div>
                                    <div class="col-12 col-md-6 col-xl-4"><label class="form-label">Модель</label><select name="modelId" class="form-select" asp-items="@(new SelectList(models, "Value", "Text", a.ModelId))"></select></div>
                                    <div class="col-12 col-md-6 col-xl-4"><label class="form-label">Цвет</label><select name="colorId" class="form-select" asp-items="@(new SelectList(colors, "Value", "Text", a.ColorId))"></select></div>
                                    <div class="col-12 col-md-6 col-xl-4"><label class="form-label">Кожа</label><select name="leatherId" class="form-select" asp-items="@(new SelectList(leathers, "Value", "Text", a.LeatherId))"></select></div>
                                    <div class="col-12 col-md-6 col-xl-4"><label class="form-label">Подкладка</label><select name="liningId" class="form-select" asp-items="@(new SelectList(linings, "Value", "Text", a.LiningId))"></select></div>
                                    <div class="col-12 col-md-6 col-xl-4"><label class="form-label">Подошва</label><select name="soleId" class="form-select" asp-items="@(new SelectList(soles, "Value", "Text", a.SoleId))"></select></div>
                                    <div class="col-12 col-lg-6"><label class="form-label">Заменить фотографию</label><input type="file" name="image" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" /></div>
                                    <div class="col-12 col-lg-6 d-flex flex-wrap align-items-end justify-content-between gap-3">
                                        <div class="form-check"><input class="form-check-input" type="checkbox" name="removeImage" value="true" id="remove-image-@a.Id" /><label class="form-check-label" for="remove-image-@a.Id">Удалить фотографию</label></div>
                                        <button class="btn btn-primary" type="submit">Сохранить изменения</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    @foreach (var a in Model.Articles.Where(x => !string.IsNullOrWhiteSpace(x.ImageFileName)))
    {
        var modalId = $"article-image-{a.Id}";
        <div class="modal fade" id="@modalId" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">
                    <div class="modal-header"><h5 class="modal-title">Артикул @a.Article</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button></div>
                    <div class="modal-body text-center"><img src="@Url.Action("Get", "ArticleImages", new { id = a.Id })" class="img-fluid" alt="Фотография артикула @a.Article" /></div>
                </div>
            </div>
        </div>
    }
}
else
{
    var isModels=Model.Tab=="models"; var isColors=Model.Tab=="colors"; var isLeathers=Model.Tab=="leathers"; var isLinings=Model.Tab=="linings"; var isSoles=Model.Tab=="soles";
    var title=isModels?"модель":isColors?"цвет":isLeathers?"кожу":isLinings?"подкладку":"подошву";
    var searchName=isModels?"searchModels":isColors?"searchColors":isLeathers?"searchLeathers":isLinings?"searchLinings":"searchSoles";
    var searchValue=isModels?Model.SearchModels:isColors?Model.SearchColors:isLeathers?Model.SearchLeathers:isLinings?Model.SearchLinings:Model.SearchSoles;
    var digits=isModels?3:isColors?2:isSoles?3:1;
    <form method="get" class="row g-2 mb-3 align-items-end"><input type="hidden" name="tab" value="@Model.Tab"/><div class="col-sm-8 col-lg-6"><label class="form-label" for="referenceSearch">Поиск</label><input id="referenceSearch" class="form-control" name="@searchName" value="@searchValue" placeholder="Поиск по названию или коду"/></div><div class="col-auto d-flex gap-2"><button class="btn btn-primary">Найти</button><a asp-action="Index" asp-route-tab="@Model.Tab" class="btn btn-light border">Сброс</a></div></form>
    @if(canManage){<div class="card mb-4"><div class="card-body"><h5>Добавить: @title</h5><form asp-action="@(isModels?"CreateModel":isColors?"CreateColor":isLeathers?"CreateLeather":isLinings?"CreateLining":"CreateSole")" method="post" class="row g-2">@Html.AntiForgeryToken()<div class="col-md-6"><input name="name" class="form-control" placeholder="Название" required maxlength="100"/></div><div class="col-md-3"><input name="code" class="form-control" placeholder="Код (@digits цифр)" required pattern="[0-9]{@digits}" maxlength="@digits"/></div><div class="col-md-3"><button class="btn btn-primary w-100">Добавить</button></div></form></div></div>}
    <div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Название</th><th>Код</th>@if(canManage){<th>Действия</th>}</tr></thead><tbody>
    @if(isModels){@foreach(var x in Model.Models){var f=$"model-{x.Id}";<tr><td><input form="@f" name="name" value="@x.Name" class="form-control" required maxlength="100"/></td><td><input form="@f" name="code" value="@x.Code" class="form-control" required pattern="[0-9]{3}" maxlength="3"/></td>@if(canManage){<td><form id="@f" asp-action="UpdateModel" method="post" class="d-inline-block me-1">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"/><button class="btn btn-sm btn-outline-primary">Сохранить</button></form><form asp-action="DeleteModel" method="post" class="d-inline-block" onsubmit="return confirm('Удалить модель?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"/><button class="btn btn-sm btn-outline-danger">Удалить</button></form></td>}</tr>}}
    @if(isColors){@foreach(var x in Model.Colors){var f=$"color-{x.Id}";<tr><td><input form="@f" name="name" value="@x.Name" class="form-control" required maxlength="100"/></td><td><input form="@f" name="code" value="@x.Code" class="form-control" required pattern="[0-9]{2}" maxlength="2"/></td>@if(canManage){<td><form id="@f" asp-action="UpdateColor" method="post" class="d-inline-block me-1">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"/><button class="btn btn-sm btn-outline-primary">Сохранить</button></form><form asp-action="DeleteColor" method="post" class="d-inline-block" onsubmit="return confirm('Удалить цвет?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"/><button class="btn btn-sm btn-outline-danger">Удалить</button></form></td>}</tr>}}
    @if(isLeathers){@foreach(var x in Model.Leathers){var f=$"leather-{x.Id}";<tr><td><input form="@f" name="name" value="@x.Name" class="form-control" required maxlength="100"/></td><td><input form="@f" name="code" value="@x.Code" class="form-control" required pattern="[0-9]" maxlength="1"/></td>@if(canManage){<td><form id="@f" asp-action="UpdateLeather" method="post" class="d-inline-block me-1">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"/><button class="btn btn-sm btn-outline-primary">Сохранить</button></form><form asp-action="DeleteLeather" method="post" class="d-inline-block" onsubmit="return confirm('Удалить кожу?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"/><button class="btn btn-sm btn-outline-danger">Удалить</button></form></td>}</tr>}}
    @if(isLinings){@foreach(var x in Model.Linings){var f=$"lining-{x.Id}";<tr><td><input form="@f" name="name" value="@x.Name" class="form-control" required maxlength="100"/></td><td><input form="@f" name="code" value="@x.Code" class="form-control" required pattern="[0-9]" maxlength="1"/></td>@if(canManage){<td><form id="@f" asp-action="UpdateLining" method="post" class="d-inline-block me-1">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"/><button class="btn btn-sm btn-outline-primary">Сохранить</button></form><form asp-action="DeleteLining" method="post" class="d-inline-block" onsubmit="return confirm('Удалить подкладку?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"/><button class="btn btn-sm btn-outline-danger">Удалить</button></form></td>}</tr>}}
    @if(isSoles){@foreach(var x in Model.Soles){var f=$"sole-{x.Id}";<tr><td><input form="@f" name="name" value="@x.Name" class="form-control" required maxlength="100"/></td><td><input form="@f" name="code" value="@x.Code" class="form-control" required pattern="[0-9]{3}" maxlength="3"/></td>@if(canManage){<td><form id="@f" asp-action="UpdateSole" method="post" class="d-inline-block me-1">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"/><button class="btn btn-sm btn-outline-primary">Сохранить</button></form><form asp-action="DeleteSole" method="post" class="d-inline-block" onsubmit="return confirm('Удалить подошву?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"/><button class="btn btn-sm btn-outline-danger">Удалить</button></form></td>}</tr>}}
    </tbody></table></div>
}
@functions { private static string GenderName(Gender g)=>g switch { Gender.Female=>"Женская",Gender.Male=>"Мужская",Gender.FemaleXl=>"Женская XL",Gender.MaleXl=>"Мужская XL",_=>"Неизвестно"}; }
