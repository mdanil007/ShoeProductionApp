@model ShoeProductionApp.ViewModels.ReferenceIndexViewModel
@using ShoeProductionApp.Entities
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Справочник";

    var canManage = User.IsInRole("Руководитель") || User.IsInRole("Мастер");

    var colors = Model.Colors
        .Select(x => new SelectListItem($"{x.Name} (код {x.Code})", x.Id.ToString()))
        .ToList();

    var models = Model.Models
        .Select(x => new SelectListItem($"{x.Name} (код {x.Code}, цвет {x.Color.Name})", x.Id.ToString()))
        .ToList();

    var leathers = Model.Leathers
        .Select(x => new SelectListItem($"{x.Name} (код {x.Code})", x.Id.ToString()))
        .ToList();

    var linings = Model.Linings
        .Select(x => new SelectListItem($"{x.Name} (код {x.Code})", x.Id.ToString()))
        .ToList();
}

<h1>Справочник</h1>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success" role="alert">@success</div>
}

@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(Model.Tab == "articles" ? "active" : "")"
           asp-action="Index" asp-route-tab="articles">Артикулы</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.Tab == "models" ? "active" : "")"
           asp-action="Index" asp-route-tab="models">Модели</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.Tab == "colors" ? "active" : "")"
           asp-action="Index" asp-route-tab="colors">Цвета</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.Tab == "leathers" ? "active" : "")"
           asp-action="Index" asp-route-tab="leathers">Кожа</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.Tab == "linings" ? "active" : "")"
           asp-action="Index" asp-route-tab="linings">Подкладка</a>
    </li>
</ul>

@if (Model.Tab == "models")
{
    <form method="get" asp-action="Index" class="row g-2 mb-3">
        <input type="hidden" name="tab" value="models" />
        <div class="col-sm-8">
            <input class="form-control" name="searchModels" value="@Model.SearchModels"
                   placeholder="Поиск по названию или коду модели" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary">Найти</button>
        </div>
        <div class="col-auto">
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-tab="models">Сбросить</a>
        </div>
    </form>

    @if (canManage)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5>Добавить модель</h5>
                <form asp-action="CreateModel" method="post" class="row g-2">
                    @Html.AntiForgeryToken()

                    <div class="col-md-4">
                        <label class="form-label">Название</label>
                        <input name="name" class="form-control" required maxlength="100" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Код (2 цифры)</label>
                        <input name="code" class="form-control" required pattern="[0-9]{2}" maxlength="2" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Цвет</label>
                        <select name="colorId" class="form-select" asp-items="colors" required>
                            <option value="">Выберите цвет</option>
                        </select>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">Добавить</button>
                    </div>
                </form>
            </div>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Название</th>
                    <th>Код</th>
                    <th>Цвет</th>
                    @if (canManage)
                    {
                        <th>Действия</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model.Models.Count == 0)
                {
                    <tr>
                        <td colspan="@(canManage ? 4 : 3)" class="text-muted">Записей пока нет.</td>
                    </tr>
                }

                @foreach (var item in Model.Models)
                {
                    <tr>
                        @if (canManage)
                        {
                            var updateFormId = $"update-model-{item.Id}";
                            var deleteFormId = $"delete-model-{item.Id}";

                            <td>
                                <input form="@updateFormId" name="name" class="form-control"
                                       value="@item.Name" required maxlength="100" />
                            </td>
                            <td>
                                <input form="@updateFormId" name="code" class="form-control"
                                       value="@item.Code" required pattern="[0-9]{2}" maxlength="2" />
                            </td>
                            <td>
                                <select form="@updateFormId" name="colorId" class="form-select"
                                        asp-items="@(new SelectList(colors, "Value", "Text", item.ColorId))">
                                </select>
                            </td>
                            <td>
                                <div class="d-flex flex-wrap gap-2">
                                    <form id="@updateFormId" asp-action="UpdateModel" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Сохранить</button>
                                    </form>

                                    <form id="@deleteFormId" asp-action="DeleteModel" method="post"
                                          onsubmit="return confirm('Удалить модель?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                                    </form>
                                </div>
                            </td>
                        }
                        else
                        {
                            <td>@item.Name</td>
                            <td>@item.Code</td>
                            <td>@item.Color.Name</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (Model.Tab == "articles")
{
    <form method="get" asp-action="Index" class="row g-2 mb-3">
        <input type="hidden" name="tab" value="articles" />
        <div class="col-sm-8">
            <input class="form-control" name="searchArticles" value="@Model.SearchArticles"
                   placeholder="Поиск по шестизначному артикулу" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary">Найти</button>
        </div>
        <div class="col-auto">
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-tab="articles">Сбросить</a>
        </div>
    </form>

    @if (canManage)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5>Добавить артикул</h5>
                <form asp-action="CreateArticle" method="post" class="row g-2">
                    @Html.AntiForgeryToken()

                    <div class="col-md-2">
                        <label class="form-label">Пол</label>
                        <select name="gender" class="form-select">
                            <option value="8">Женский (8)</option>
                            <option value="9">Мужской (9)</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Модель и цвет</label>
                        <select name="modelId" class="form-select" asp-items="models" required>
                            <option value="">Выберите модель</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Кожа</label>
                        <select name="leatherId" class="form-select" asp-items="leathers" required>
                            <option value="">Выберите кожу</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Подкладка</label>
                        <select name="liningId" class="form-select" asp-items="linings" required>
                            <option value="">Выберите подкладку</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">Добавить артикул</button>
                    </div>
                </form>
            </div>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Артикул</th>
                    <th>Пол</th>
                    <th>Модель</th>
                    <th>Цвет</th>
                    <th>Кожа</th>
                    <th>Подкладка</th>
                    @if (canManage)
                    {
                        <th>Действия</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model.Articles.Count == 0)
                {
                    <tr>
                        <td colspan="@(canManage ? 7 : 6)" class="text-muted">Артикулов пока нет.</td>
                    </tr>
                }

                @foreach (var item in Model.Articles)
                {
                    <tr>
                        @if (canManage)
                        {
                            var updateFormId = $"update-article-{item.Id}";
                            var deleteFormId = $"delete-article-{item.Id}";

                            <td class="fw-bold text-nowrap">@item.Article</td>
                            <td>
                                <select form="@updateFormId" name="gender" class="form-select"
                                        asp-items="@(new SelectList(new[] { new { Value = "8", Text = "Женский (8)" }, new { Value = "9", Text = "Мужской (9)" } }, "Value", "Text", ((int)item.Gender).ToString()))">
                                </select>
                            </td>
                            <td>
                                <select form="@updateFormId" name="modelId" class="form-select"
                                        asp-items="@(new SelectList(models, "Value", "Text", item.ModelId))">
                                </select>
                            </td>
                            <td class="text-nowrap">@item.ColorName (@item.ColorCode)</td>
                            <td>
                                <select form="@updateFormId" name="leatherId" class="form-select"
                                        asp-items="@(new SelectList(leathers, "Value", "Text", item.LeatherId))">
                                </select>
                            </td>
                            <td>
                                <select form="@updateFormId" name="liningId" class="form-select"
                                        asp-items="@(new SelectList(linings, "Value", "Text", item.LiningId))">
                                </select>
                            </td>
                            <td>
                                <div class="d-flex flex-column gap-2">
                                    <form id="@updateFormId" asp-action="UpdateArticle" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary w-100">Сохранить</button>
                                    </form>

                                    <form id="@deleteFormId" asp-action="DeleteArticle" method="post"
                                          onsubmit="return confirm('Удалить артикул?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger w-100">Удалить</button>
                                    </form>
                                </div>
                            </td>
                        }
                        else
                        {
                            <td class="fw-bold">@item.Article</td>
                            <td>@(item.Gender == Gender.Female ? "Женский" : "Мужской")</td>
                            <td>@item.ModelName (@item.ModelCode)</td>
                            <td>@item.ColorName (@item.ColorCode)</td>
                            <td>@item.LeatherName</td>
                            <td>@item.LiningName</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
