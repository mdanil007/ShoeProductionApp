@model ShoeProductionApp.ViewModels.OrderDetailsViewModel

@{
    ViewData["Title"] = $"Заказ №{Model.Id}";
}

<h1>Заказ №@Model.Id</h1>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success">@success</div>
}

@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<dl class="row">
    <dt class="col-sm-3">Клиент</dt>
    <dd class="col-sm-9">@Model.ClientName</dd>

    <dt class="col-sm-3">Артикул</dt>
    <dd class="col-sm-9">@Model.Article</dd>

    <dt class="col-sm-3">Создал</dt>
    <dd class="col-sm-9">@Model.CreatorName</dd>

    <dt class="col-sm-3">Дата создания</dt>
    <dd class="col-sm-9">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd>

    <dt class="col-sm-3">Плановая отправка</dt>
    <dd class="col-sm-9">@Model.PlannedShipmentDate.ToString("dd.MM.yyyy")</dd>

    @if (Model.ActualShipmentDate.HasValue)
    {
        <dt class="col-sm-3">Фактическая отправка</dt>
        <dd class="col-sm-9">
            @Model.ActualShipmentDate.Value.ToString("dd.MM.yyyy HH:mm")
        </dd>
    }

    <dt class="col-sm-3">Статус</dt>
    <dd class="col-sm-9">@Model.Status</dd>

    <dt class="col-sm-3">Общее количество</dt>
    <dd class="col-sm-9">@Model.TotalPairs пар</dd>

    <dt class="col-sm-3">Комментарий</dt>
    <dd class="col-sm-9">@(Model.Comment ?? "—")</dd>
</dl>

<h2>Размеры</h2>

<table class="table">
    <thead>
        <tr>
            <th>Размер</th>
            <th>Количество пар</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var size in Model.Sizes)
        {
            <tr>
                <td>@size.Size</td>
                <td>@size.Count</td>
            </tr>
        }
    </tbody>
</table>

<h2>История статусов</h2>

@if (Model.StatusHistory.Count == 0)
{
    <p class="text-muted">История отсутствует.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Статус</th>
                <th>Дата и время</th>
                <th>Пользователь</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.StatusHistory)
            {
                <tr>
                    <td>@item.Status</td>
                    <td>@item.ChangedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@item.ChangedByUserName</td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-action="Index" class="btn btn-outline-secondary">К списку заказов</a>
