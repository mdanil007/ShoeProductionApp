@using ShoeProductionApp.Extensions
@model ShoeProductionApp.ViewModels.OrderDetailsViewModel

@{
    ViewData["Title"] = $"Заказ №{Model.Id}";
}

<h1>Заказ №@Model.Id</h1>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success">@success</div>
}

@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<dl class="row">
    <dt class="col-sm-3">Клиент</dt>
    <dd class="col-sm-9">@Model.ClientName</dd>

    <dt class="col-sm-3">Артикул</dt>
    <dd class="col-sm-9">
        @Model.Article
        @if (!string.IsNullOrWhiteSpace(Model.ArticleImageFileName))
        {
            <div class="mt-2">
                <button type="button" class="btn p-0 border-0" data-bs-toggle="modal" data-bs-target="#orderArticleImageModal" aria-label="Увеличить фотографию артикула">
                    <img src="@Url.Action("Get", "ArticleImages", new { id = Model.ProductId })" class="article-thumbnail" alt="Фотография артикула" />
                </button>
            </div>
        }
    </dd>

    <dt class="col-sm-3">Создал</dt>
    <dd class="col-sm-9">@Model.CreatorName</dd>

    <dt class="col-sm-3">Дата создания</dt>
    <dd class="col-sm-9">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd>

    <dt class="col-sm-3">Плановая отправка</dt>
    <dd class="col-sm-9">@Model.PlannedShipmentDate.ToString("dd.MM.yyyy")</dd>

    @if (Model.ActualShipmentDate.HasValue)
    {
        <dt class="col-sm-3">Фактическая отправка</dt>
        <dd class="col-sm-9">
            @Model.ActualShipmentDate.Value.ToString("dd.MM.yyyy HH:mm")
        </dd>
    }

    <dt class="col-sm-3">Статус</dt>
    <dd class="col-sm-9">@Model.Status.ToRussian()</dd>

    <dt class="col-sm-3">Общее количество</dt>
    <dd class="col-sm-9">@Model.TotalPairs пар</dd>

    <dt class="col-sm-3">Комментарий</dt>
    <dd class="col-sm-9">@(Model.Comment ?? "—")</dd>
</dl>

<h2>Размеры</h2>

<table class="table">
    <thead>
        <tr>
            <th>Размер</th>
            <th>Количество пар</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var size in Model.Sizes)
        {
            <tr>
                <td>@size.Size</td>
                <td>@size.Count</td>
            </tr>
        }
    </tbody>
</table>

<h2>История статусов</h2>

@if (Model.StatusHistory.Count == 0)
{
    <p class="text-muted">История отсутствует.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Статус</th>
                <th>Дата и время</th>
                <th>Пользователь</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.StatusHistory)
            {
                <tr>
                    <td>@item.Status.ToRussian()</td>
                    <td>@item.ChangedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@item.ChangedByUserName</td>
                </tr>
            }
        </tbody>
    </table>
}

@if (!string.IsNullOrWhiteSpace(Model.ArticleImageFileName))
{
    <div class="modal fade" id="orderArticleImageModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">Фотография артикула</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button></div>
                <div class="modal-body text-center"><img src="@Url.Action("Get", "ArticleImages", new { id = Model.ProductId })" class="img-fluid" alt="Фотография артикула" /></div>
            </div>
        </div>
    </div>
}

<a asp-action="Index" class="btn btn-outline-secondary">К списку заказов</a>
