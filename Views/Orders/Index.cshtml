@using ShoeProductionApp.Entities
@using ShoeProductionApp.Extensions
@model List<ShoeProductionApp.ViewModels.OrderListItemViewModel>

@{
    ViewData["Title"] = "Заказы";
}

<h1>Заказы</h1>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success">@success</div>
}

@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger">@error</div>
}


<form method="get" asp-action="Index" class="mb-4">
    @* Строка поиска *@
    <div class="row g-2 mb-3">
        <div class="col-12 col-md-8 col-lg-6">
            <label for="orderSearch" class="form-label">
                Поиск заказов
            </label>
            <input id="orderSearch"
                   type="text"
                   name="search"
                   value="@ViewData["Search"]"
                   class="form-control"
                   placeholder="Клиент, артикул или номер" />
        </div>

        <div class="col-12 col-md-auto d-flex align-items-end">
            <button type="submit" class="btn btn-primary">
                Найти
            </button>
        </div>
    </div>

    @* Строка фильтров *@
    <div class="row g-2 align-items-end">
        <div class="col-12 col-md-4 col-lg-3">
            <label for="orderStatus" class="form-label">
                Статус
            </label>
            <select id="orderStatus" name="status" class="form-select">
                <option value=""
                        selected="@(string.IsNullOrEmpty(ViewData["Status"]?.ToString()))">
                    Все статусы
                </option>

                @foreach (var item in Enum.GetValues<OrderStatus>())
                {
                    <option value="@item"
                            selected="@(ViewData["Status"]?.ToString() == item.ToString())">
                        @item.ToRussian()
                    </option>
                }
            </select>
        </div>

        <div class="col-12 col-md-4 col-lg-2">
            <label for="plannedShipmentDate" class="form-label">
                Плановая дата
            </label>
            <input id="plannedShipmentDate"
                   type="date"
                   name="plannedShipmentDate"
                   value="@ViewData["PlannedShipmentDate"]"
                   class="form-control" />
        </div>

        <div class="col-12 col-md-4 col-lg-2">
            <label for="actualShipmentDate" class="form-label">
                Фактическая дата
            </label>
            <input id="actualShipmentDate"
                   type="date"
                   name="actualShipmentDate"
                   value="@ViewData["ActualShipmentDate"]"
                   class="form-control" />
        </div>

        <div class="col-12 col-md-auto d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                Применить
            </button>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Сбросить
            </a>
        </div>
    </div>
</form>


@if (User.IsInRole("Руководитель") || User.IsInRole("Мастер"))
{
    <p>
        <a asp-action="Create" class="btn btn-success">Создать заказ</a>
    </p>
}

@if (Model.Count == 0)
{
    <p class="text-muted">Заказы отсутствуют.</p>
}
else
{
    <div class="row g-3">
        @foreach (var order in Model)
        {
            <div class="col-12">
                <div class="card @(order.IsOverdue ? "border-danger border-2" : "")">
                    <div class="card-body">
                        <a asp-action="Details" asp-route-id="@order.Id"
                           class="text-decoration-none text-reset">
                            <h5 class="card-title">Заказ №@order.Id</h5>
                        </a>

                        <p class="mb-1">Клиент: @order.ClientName</p>
                        <p class="mb-1">Артикул: @order.Article</p>
                        <p class="mb-1">Количество пар: @order.TotalPairs</p>
                        <p class="mb-1">Статус: @order.Status.ToRussian()</p>
                        <p class="mb-1">
                            Плановая отправка:
                            @order.PlannedShipmentDate.ToString("dd.MM.yyyy")
                        </p>

                        @if (order.ActualShipmentDate.HasValue)
                        {
                            <p class="mb-1">
                                Фактическая отправка:
                                @order.ActualShipmentDate.Value.ToString("dd.MM.yyyy HH:mm")
                            </p>
                        }

                        @if (order.IsOverdue)
                        {
                            <p class="text-danger fw-bold mb-2">Просрочено</p>
                        }

                        @if (User.IsInRole("Руководитель") ||
                             User.IsInRole("Мастер"))
                        {
                            @if (order.Status != OrderStatus.Shipped &&
                                 order.Status != OrderStatus.Cancelled)
                            {
                                <form asp-action="AdvanceStatus"
                                      asp-route-id="@order.Id"
                                      method="post" class="d-inline">
                                    <button type="submit" class="btn btn-primary btn-sm">
                                        Перевести на следующий этап
                                    </button>
                                </form>
                            }
                        }

                        @if (User.IsInRole("Руководитель") &&
                             order.Status != OrderStatus.Shipped &&
                             order.Status != OrderStatus.Cancelled)
                        {
                            <form asp-action="Cancel" asp-route-id="@order.Id"
                                  method="post" class="d-inline"
                                  onsubmit="return confirm('Отменить заказ №@order.Id?');">
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    Отменить
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
