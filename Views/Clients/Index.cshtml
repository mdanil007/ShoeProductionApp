@model ShoeProductionApp.ViewModels.ClientIndexViewModel
@using ShoeProductionApp.Entities
@{
    ViewData["Title"] = "Клиенты"; var canManage = User.IsInRole("Руководитель");
}
<h1 class="mb-4">Клиенты</h1>
@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}
<div class="d-flex justify-content-between align-items-center mb-3"><p class="text-muted mb-0">Всего клиентов: @Model.Clients.Count</p>@if (canManage) {
    <a asp-action="Create" class="btn btn-primary">Добавить клиента</a>
}
</div>
<form asp-action="Index" method="get" class="card card-body mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-6"><label for="search" class="form-label">Поиск</label><input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Название, контакт, телефон, email или адрес" /></div>
        <div class="col-md-3"><label for="type" class="form-label">Тип клиента</label><select id="type" name="type" class="form-select"><option value="">Все типы</option><option value="Shop" selected="@(Model.Type == ClientType.Shop)">Магазин</option><option value="Marketplace" selected="@(Model.Type == ClientType.Marketplace)">Маркетплейс</option></select></div>
        <div class="col-md-3 d-flex gap-2"><button type="submit" class="btn btn-outline-primary">Найти</button><a asp-action="Index" class="btn btn-outline-secondary">Сбросить</a></div>
    </div>
</form>
@if (Model.Clients.Count == 0)
{
    <div class="text-muted py-4">Клиенты не найдены.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle clients-table">
            <thead><tr><th>Название</th><th>Тип</th><th>Контактное лицо</th><th>Телефон</th><th>Электронная почта</th><th>Адрес</th>@if (canManage) {
                <th class="text-end">Действия</th>
            }
        </tr></thead>
        <tbody>
        @foreach (var client in Model.Clients)
        {
            <tr>
                <td class="text-wrap text-break">
                    <strong>@client.Name</strong>
                    @if (!string.IsNullOrWhiteSpace(client.Comment)) {
                        <div class="small text-muted">@client.Comment</div>
                    }
                </td>
                <td>@(client.Type == ClientType.Shop ? "Магазин" : "Маркетплейс")</td>
                <td class="text-wrap text-break">@(string.IsNullOrWhiteSpace(client.ContactPerson) ? "—" : client.ContactPerson)</td>
                <td class="text-wrap text-break">@(string.IsNullOrWhiteSpace(client.Phone) ? "—" : client.Phone)</td>
                <td class="text-wrap text-break">@(string.IsNullOrWhiteSpace(client.Email) ? "—" : client.Email)</td>
                <td class="text-wrap text-break">@(string.IsNullOrWhiteSpace(client.Address) ? "—" : client.Address)</td>
                @if (canManage) {
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@client.Id" class="btn btn-sm btn-outline-primary">Изменить</a> 
                        <a asp-action="Delete" asp-route-id="@client.Id" class="btn btn-sm btn-outline-danger">Удалить</a>
                    </td>
                }
            </tr>
        }
        </tbody>
        </table>
    </div>
}
