<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BELAV man's footwear</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ShoeProductionApp.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/images/favicon.png" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg site-navbar">
            <div class="container-fluid site-nav-container">
                <a class="navbar-brand d-flex align-items-center"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index"
                   aria-label="Belav man's footwear">
                    <img src="~/images/logo.png" alt="Belav man's footwear" class="site-logo" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Открыть меню">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (User.IsInRole("Менеджер") || User.IsInRole("Мастер") || User.IsInRole("Администратор"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Orders" asp-action="Index">Заказы</a></li>
                        }
                        @if (User.IsInRole("Менеджер") || User.IsInRole("Мастер"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Clients" asp-action="Index">Клиенты</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Reference" asp-action="Index">Справочник</a></li>
                        }
                        @if (User.IsInRole("Администратор"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="Index">Пользователи</a></li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    @{
        var isHomePage = ViewContext.RouteData.Values["controller"]?.ToString() == "Home"
            && ViewContext.RouteData.Values["action"]?.ToString() == "Index";
    }
    <div class="@(isHomePage ? "home-main-wrapper" : "container app-main-wrapper")">
        <main role="main" class="@(isHomePage ? "home-main" : "pb-4")">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container site-footer-inner">
            <span class="footer-copyright">&copy; @DateTime.Now.Year - BELAV man's footwear. Все права защищены.</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
