@model List<ShoeProductionApp.ViewModels.UserListItemViewModel>

@{
    ViewData["Title"] = "Пользователи";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Пользователи</h1>
        <a asp-action="Create" class="btn btn-primary">
            Создать пользователя
        </a>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success" role="alert">@success</div>
    }

    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    @if (Model.Count == 0)
    {
        <p class="text-muted">Пользователи отсутствуют.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Логин</th>
                        <th>Роль</th>
                        <th>Состояние</th>
                        <th class="text-end">Действие</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.UserName</td>
                            <td>@user.Role</td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="text-success">Активен</span>
                                }
                                else
                                {
                                    <span class="text-danger">Заблокирован</span>
                                }
                            </td>
                            <td class="text-end">
                                <form asp-action="ToggleActive"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Изменить состояние пользователя @user.UserName?');">
                                    <input type="hidden"
                                           name="id"
                                           value="@user.Id" />

                                    @if (user.IsActive)
                                    {
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Заблокировать
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-success">
                                            Разблокировать
                                        </button>
                                    }
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
