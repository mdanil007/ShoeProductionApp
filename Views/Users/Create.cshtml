@model ShoeProductionApp.ViewModels.CreateUserViewModel

@{
    ViewData["Title"] = "Создание пользователя";
    var roles = ViewBag.Roles as string[] ?? [];
}

<div class="container py-4">
    <h1 class="h3 mb-4">Создание пользователя</h1>

    <div class="row">
        <div class="col-md-6 col-lg-5">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"
                     role="alert"></div>

                <div class="mb-3">
                    <label asp-for="UserName" class="form-label"></label>
                    <input asp-for="UserName"
                           class="form-control"
                           autocomplete="off" />
                    <span asp-validation-for="UserName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password"
                           class="form-control"
                           autocomplete="new-password" />
                    <span asp-validation-for="Password"
                          class="text-danger"></span>
                    <div class="form-text">
                        Пароль должен соответствовать требованиям Identity
                        и содержать не менее 8 символов.
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Role" class="form-label"></label>
                    <select asp-for="Role" class="form-select">
                        <option value="">Выберите роль</option>
                        @foreach (var role in roles)
                        {
                            <option value="@role">@role</option>
                        }
                    </select>
                    <span asp-validation-for="Role"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Создать
                    </button>
                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Отмена
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
